# Copy these values into your shell environment. PlaylistBridge never reads this file directly.
PLAYLISTBRIDGE_SPOTIFY_TOKEN=optional-existing-user-access-token
# The web UI normally accepts Client ID and Client Secret through Connect with Spotify.
PLAYLISTBRIDGE_APPLE_DEVELOPER_TOKEN=apple-developer-jwt
PLAYLISTBRIDGE_APPLE_USER_TOKEN=apple-music-user-token
PLAYLISTBRIDGE_APPLE_STOREFRONT=us
PLAYLISTBRIDGE_YOUTUBE_TOKEN=google-oauth-access-token
